# --- Database ---
DATABASE_URL=postgresql://jarvis:jarvis@db:5432/jarvis

# --- Redis / jobs ---
REDIS_URL=redis://redis:6379/0

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM provider ---
# ollama = fully local/free (default). groq = free-tier cloud API (much
# larger/faster models, needs a free key from https://console.groq.com/keys).
# Embeddings always use Ollama regardless of this setting — see llm_provider.py.
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Mode ---
# demo = mock providers everywhere (default, zero-cost, safe)
# live = real provider adapters (requires the credentials below)
JARVIS_MODE=demo

# --- Real social provider credentials (only needed when JARVIS_MODE=live) ---
# See tools/social/linkedin.py, meta.py, x_provider.py docstrings for exact
# setup steps (developer app registration, permission review, token scopes).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Employee comms (only needed when JARVIS_MODE=live) ---
# See tools/employee/teams_provider.py, whatsapp_provider.py docstrings.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-in-local-env

# --- Auth (Phase 2) ---
JWT_SECRET=change-me-in-local-env
